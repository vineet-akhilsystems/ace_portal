# Copy this file to `.env` and fill in real values. Never commit `.env`.
DB_HOST=your.server.ip
DB_PORT=1433
DB_NAME=Akhil_Reporting
DB_USER=your_username
DB_PASSWORD=your_password
DB_DRIVER=ODBC Driver 17 for SQL Server

# Optional tuning:
# DB_CACHE_TTL=120        # seconds a cached snapshot stays valid
# DB_QUERY_TIMEOUT=60     # per-query timeout in seconds

# Remote deployment (Cloud Run) only — leave unset for local stdio use:
# MCP_TRANSPORT=http        # switches the server to Streamable HTTP instead of stdio
# MCP_AUTH_TOKEN=           # shared secret; requests must send `Authorization: Bearer <token>`
# PORT=8080                 # Cloud Run sets this automatically
